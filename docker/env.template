# ---------------------------------------------------------------------------
# Tune Up — server .env for the Docker stack
# Copy to the project root as `.env` on the server, then fill in the secrets.
#   cp docker/env.template .env
# Generate an APP_KEY with:
#   docker compose run --rm app php artisan key:generate --show
# ---------------------------------------------------------------------------

APP_NAME="Tune Up Precision"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tuneupprecision.co.za

# REQUIRED — paste the generated key (starts with base64:)
APP_KEY=

# Published host port for the app container (reverse proxy points here)
APP_PORT=8093

# Set to true for the FIRST deploy only, to create the admin + demo content.
# Set back to false afterwards.
RUN_SEED=false

# Admin (Filament /admin) — used when RUN_SEED=true
ADMIN_NAME=Dirk
ADMIN_EMAIL=dirk@tuneupprecision.co.za
ADMIN_PASSWORD=change-me-strong-password

# Database (PostgreSQL container)
DB_DATABASE=tuneupprecision
DB_USERNAME=tuneup
DB_PASSWORD=change-me-strong-db-password

# Cookie domain for sessions (leading dot covers www + apex)
SESSION_DOMAIN=.tuneupprecision.co.za

# Mail (leave as log until real SMTP creds are ready)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tuneupprecision.co.za
MAIL_FROM_NAME="Tune Up"

# EFT bank details (shown on the admin Settings page / future checkout)
EFT_BANK_NAME=FNB
EFT_ACCOUNT_NAME="Tune Up Long Range Precision Shooting"
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=250655
