APP_NAME="Tune Up Precision"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tuneupprecision
DB_USERNAME=postgres
DB_PASSWORD=

# --- Admin seed credentials (used by DatabaseSeeder) ---
ADMIN_NAME="Dirk"
ADMIN_EMAIL=dirk@tuneupprecision.co.za
ADMIN_PASSWORD=password

# --- Legal identity (config/legal.php; tel/email/VAT/dealer also editable in admin Settings) ---
LEGAL_NAME=                          # registered / trading-as legal name
LEGAL_TRADING_AS=                    # public trading name if different
LEGAL_STATUS=                        # sole proprietor / Pty Ltd / etc
LEGAL_REGISTRATION_NO=               # CIPC or other registration number
LEGAL_VAT_NO=                        # VAT registration number
LEGAL_DEALER_LICENCE_NO=             # firearms dealer licence number
LEGAL_OFFICE_BEARERS=                # names of office bearers
LEGAL_PHYSICAL_ADDRESS=              # statutory street address (ECTA s43)
LEGAL_POSTAL_ADDRESS=                # postal address if different
LEGAL_EMAIL=info@tuneupprecision.co.za
LEGAL_PHONE=                         # public telephone number
LEGAL_BOOKING_FULL_REFUND_DAYS=14    # cancel with more than this many days for a full refund
LEGAL_BOOKING_DEPOSIT_FORFEIT_DAYS=7 # below this, no refund / no-show
LEGAL_SHIPPING_DISPATCH_DAYS=3–5     # business days to hand in-stock merch to the courier
LEGAL_SHIPPING_COURIER=              # courier name shown on the shipping policy

# --- EFT bank details (Settings defaults) ---
EFT_BANK_NAME="FNB"
EFT_ACCOUNT_NAME="Tune Up Long Range Precision Shooting"
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE="250655"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@tuneupprecision.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# --- Mailgun (defaults; can also be set/overridden on the admin Email settings page) ---
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
